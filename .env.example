# ── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here

# ── Google ────────────────────────────────────────────────
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
CALENDAR_ID=your_calendar_id_here

# ── Timezone (IANA name) ──────────────────────────────────
# Interprets meeting times. e.g. America/New_York,
# America/Chicago, America/Los_Angeles
TIMEZONE=America/New_York

# ── Channels (right-click channel → Copy Channel ID) ──────
# These are defaults; captains can reassign any function to a
# channel at runtime with /set_channel (saved to channel_config.json).
CALENDAR_CHANNEL_ID=
AGENDA_ACHIEVEMENTS_CHANNEL_ID=    # agenda and achievements share one channel now
SIGNUPS_CHANNEL_ID=

# ── Staff Roles (right-click role → Copy ID) ──────────────
# Full unrestricted access across all divisions
CAPTAIN_ROLE_ID=
MENTOR_ROLE_ID=

# The Leader role — combined with a division role
# this makes someone the lead for that division
LEADER_ROLE_ID=

# The Students role — pinged by meeting announcements
# and the "polls are up" reminder
STUDENTS_ROLE_ID=

# ── Division Roles ────────────────────────────────────────
# One role per division, shared by everyone in it
# (both students and leaders have the same division role)
ENGINEERS_ROLE_ID=
PROGRAMMERS_ROLE_ID=
MARKETING_ROLE_ID=
CAD_ROLE_ID=
DRIVERS_ROLE_ID=
